{
  "version": 1,
  "operations": [
    {
      "id": "system.doctor",
      "description": "检查 BDTool 自身、项目路径、Provider 与 Activity 存储；装配 Editor Provider 时读取真实 Editor 状态。",
      "effect": "read",
      "environment": ["workspace", "editor"],
      "requiredCapabilities": [],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "resultSchema": {
        "type": "object",
        "required": ["status", "data"],
        "additionalProperties": true,
        "properties": {
          "status": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["state", "appVersion", "contractVersion", "checks", "providers", "unity"],
            "properties": {
              "state": { "type": "string" },
              "appVersion": { "type": "string" },
              "contractVersion": { "type": "string" },
              "checks": { "type": "array" },
              "providers": { "type": "array" },
              "unity": { "type": "object" }
            }
          },
          "changedAssets": { "type": "array" },
          "warnings": { "type": "array" },
          "errors": { "type": "array" },
          "artifacts": { "type": "array" },
          "proof": { "type": "object" },
          "next": { "type": ["object", "null"] }
        }
      },
      "timeoutSeconds": 30,
      "artifacts": [],
      "implemented": true,
      "milestone": "M1",
      "availability": "available",
      "notes": "输入严格为空对象；检查应用/契约版本、项目与 .bdtool 可写性、Activity 根、目录加载与真实 Provider 快照。Editor Provider 装配后查询真实状态：只有 ready 且报告项目与请求项目一致才 pass；未装配 skipped，超时/Provider 错误分别映射为 timeout/error 并 fail。项目根缺失时跳过审计并告警 AUDIT_UNAVAILABLE_PROJECT_MISSING，不创建目录。"
    },
    {
      "id": "operations.list",
      "description": "列出当前目录中已登记的操作及其可用性。",
      "effect": "read",
      "environment": ["workspace"],
      "requiredCapabilities": [],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "resultSchema": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["operations"],
            "properties": {
              "operations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "description", "effect", "environment", "requiredCapabilities", "timeoutSeconds", "implemented", "milestone", "availability"],
                  "properties": {
                    "id": { "type": "string" },
                    "description": { "type": "string" },
                    "effect": { "type": "string" },
                    "environment": { "type": "array" },
                    "requiredCapabilities": { "type": "array" },
                    "timeoutSeconds": { "type": "integer" },
                    "artifacts": { "type": "array" },
                    "implemented": { "type": "boolean" },
                    "milestone": { "type": "string" },
                    "availability": { "type": "string" },
                    "notes": { "type": "string" }
                  }
                }
              }
            }
          },
          "changedAssets": { "type": "array" },
          "warnings": { "type": "array" },
          "errors": { "type": "array" },
          "artifacts": { "type": "array" },
          "proof": { "type": "object" },
          "next": { "type": ["object", "null"] }
        }
      },
      "timeoutSeconds": 30,
      "artifacts": [],
      "implemented": true,
      "milestone": "M1",
      "availability": "available",
      "notes": "返回 OperationsListData；输入只允许空对象。"
    },
    {
      "id": "operations.describe",
      "description": "读取单个操作的 Schema、效果、环境、能力与超时元数据。",
      "effect": "read",
      "environment": ["workspace"],
      "requiredCapabilities": [],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId"],
        "properties": {
          "operationId": { "type": "string" }
        }
      },
      "resultSchema": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["operation"],
            "properties": {
              "operation": {
                "type": "object",
                "required": ["id", "description", "effect", "environment", "requiredCapabilities", "timeoutSeconds", "implemented", "milestone", "availability", "inputSchemaJson", "resultSchemaJson"],
                "properties": {
                  "id": { "type": "string" },
                  "description": { "type": "string" },
                  "effect": { "type": "string" },
                  "environment": { "type": "array" },
                  "requiredCapabilities": { "type": "array" },
                  "timeoutSeconds": { "type": "integer" },
                  "artifacts": { "type": "array" },
                  "implemented": { "type": "boolean" },
                  "milestone": { "type": "string" },
                  "availability": { "type": "string" },
                  "notes": { "type": "string" },
                  "inputSchemaJson": { "type": "string" },
                  "resultSchemaJson": { "type": "string" }
                }
              }
            }
          },
          "changedAssets": { "type": "array" },
          "warnings": { "type": "array" },
          "errors": { "type": "array" },
          "artifacts": { "type": "array" },
          "proof": { "type": "object" },
          "next": { "type": ["object", "null"] }
        }
      },
      "timeoutSeconds": 30,
      "artifacts": [],
      "implemented": true,
      "milestone": "M1",
      "availability": "available",
      "notes": "输入严格为 {operationId}；未知 ID 返回 NOT_FOUND，多余字段返回 INVALID_ARGUMENT。"
    },
    {
      "id": "project.context",
      "description": "返回项目路径、存在性、Unity 版本、Editor 连接状态与 Provider 能力；Editor 仅在 ready 且项目匹配时才算连接。",
      "effect": "read",
      "environment": ["workspace", "editor"],
      "requiredCapabilities": [],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "resultSchema": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["projectPath", "projectExists", "editor", "providers", "capabilities", "activityLimits"],
            "properties": {
              "projectPath": { "type": "string" },
              "projectExists": { "type": "boolean" },
              "unityVersion": { "type": ["string", "null"] },
              "editor": { "type": "object" },
              "providers": { "type": "array" },
              "capabilities": { "type": "object" },
              "activityLimits": { "type": "object" }
            }
          },
          "changedAssets": { "type": "array" },
          "warnings": { "type": "array" },
          "errors": { "type": "array" },
          "artifacts": { "type": "array" },
          "proof": { "type": "object" },
          "next": { "type": ["object", "null"] }
        }
      },
      "timeoutSeconds": 30,
      "artifacts": [],
      "implemented": true,
      "milestone": "M1",
      "availability": "available",
      "notes": "无 Unity 仍成功并保持 not-connected；真实 Editor Provider 可用时返回其状态、ProviderId、UnityVersion 与 ProcessId，只有 ready 且项目匹配才 connected。超时映射为 timeout，Provider 错误映射为 error，均不改变外层 Completed。项目缺失返回 PROJECT_NOT_FOUND。"
    },
    {
      "id": "project.inspect",
      "description": "通过 Editor Provider 读取当前场景名称与只读层级摘要。",
      "effect": "read",
      "environment": ["workspace", "editor"],
      "requiredCapabilities": ["editor.status", "editor.tool.read"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rootPath": { "type": "string" },
          "includeComponents": { "type": "boolean" },
          "includeInactive": { "type": "boolean" },
          "includeLayers": { "type": "boolean" },
          "includeTags": { "type": "boolean" },
          "includeTransform": { "type": "boolean" },
          "maxDepth": { "type": "integer", "minimum": 0, "maximum": 32 },
          "maxObjects": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "nameOnly": { "type": "boolean" }
        }
      },
      "resultSchema": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["projectPath", "unityVersion", "sceneName", "isPrefabMode", "objectCount", "hierarchy"],
            "properties": {
              "projectPath": { "type": "string" },
              "unityVersion": { "type": "string" },
              "sceneName": { "type": "string" },
              "isPrefabMode": { "type": "boolean" },
              "objectCount": { "type": "integer" },
              "hierarchy": {
                "type": "array",
                "items": { "$ref": "#/$defs/projectInspectNode" }
              }
            }
          },
          "changedAssets": { "type": "array" },
          "warnings": { "type": "array" },
          "errors": { "type": "array" },
          "artifacts": { "type": "array" },
          "proof": { "type": "object" },
          "next": { "type": ["object", "null"] }
        },
        "$defs": {
          "projectInspectNode": {
            "type": "object",
            "required": ["name", "path", "active", "components", "children"],
            "properties": {
              "name": { "type": "string" },
              "path": { "type": "string" },
              "active": { "type": "boolean" },
              "components": { "type": "array", "items": { "type": "string" } },
              "children": {
                "type": "array",
                "items": { "$ref": "#/$defs/projectInspectNode" }
              }
            }
          }
        }
      },
      "timeoutSeconds": 60,
      "artifacts": [],
      "implemented": true,
      "milestone": "M2",
      "availability": "available",
      "notes": "只读调用 unity-cli get_hierarchy；输出转换为 typed 层级，不返回上游原始响应。需要已连接 Editor 与 Bridge 0.19.1。"
    },
    {
      "id": "project.probe",
      "description": "通过 Editor Provider 的 custom tool 读取项目与当前场景的只读快照。",
      "effect": "read",
      "environment": ["editor"],
      "requiredCapabilities": ["editor.status", "editor.tool.read"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "resultSchema": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["product", "unityVersion", "platform", "sceneName", "scenePath", "sceneIsDirty", "rootObjectCount", "observedAtUtc"],
            "properties": {
              "product": { "type": "string" },
              "unityVersion": { "type": "string" },
              "platform": { "type": "string" },
              "sceneName": { "type": "string" },
              "scenePath": { "type": "string" },
              "sceneIsDirty": { "type": "boolean" },
              "rootObjectCount": { "type": "integer" },
              "observedAtUtc": { "type": "string", "format": "date-time" }
            }
          },
          "changedAssets": { "type": "array" },
          "warnings": { "type": "array" },
          "errors": { "type": "array" },
          "artifacts": { "type": "array" },
          "proof": { "type": "object" },
          "next": { "type": ["object", "null"] }
        }
      },
      "timeoutSeconds": 30,
      "artifacts": [],
      "implemented": true,
      "milestone": "M2",
      "availability": "available",
      "notes": "输入严格为空对象；产品链路已接入 ProjectProbeHandler，结果收敛为 typed 8 字段 Product/UnityVersion/Platform/SceneName/ScenePath/SceneIsDirty/RootObjectCount/ObservedAtUtc。真实 Unity 6 custom tool 已有直接 CLI 证据，但真实端到端执行仍待验证；只读，不修改场景或资源。"
    },
    {
      "id": "project.asset-snapshot",
      "description": "通过 Editor Provider 的只读工具读取单个 Prefab 的稳定资产快照。",
      "effect": "read",
      "environment": ["editor"],
      "requiredCapabilities": ["editor.status", "editor.tool.read"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetPath"],
        "properties": {
          "assetPath": { "type": "string" }
        }
      },
      "resultSchema": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["projectPath", "assetPath", "exists", "sha256", "rootObjectName", "childCount", "unityVersion"],
            "properties": {
              "projectPath": { "type": "string" },
              "assetPath": { "type": "string" },
              "exists": { "type": "boolean" },
              "sha256": { "type": "string" },
              "rootObjectName": { "type": "string" },
              "childCount": { "type": "integer" },
              "unityVersion": { "type": "string" }
            }
          },
          "changedAssets": { "type": "array" },
          "warnings": { "type": "array" },
          "errors": { "type": "array" },
          "artifacts": { "type": "array" },
          "proof": { "type": "object" },
          "next": { "type": ["object", "null"] }
        }
      },
      "timeoutSeconds": 30,
      "artifacts": [],
      "implemented": true,
      "milestone": "M3",
      "availability": "available",
      "notes": "输入严格为 {assetPath}；调用 bdtool_core_read，结果收敛为 typed 7 字段快照。资产路径语义、存在性与哈希口径由 Unity Core 负责；只读，不修改资产。真实 Unity M3 端到端尚未验证。"
    },
    {
      "id": "project.prefab-set-active",
      "description": "在 SHA-256 CAS 保护下切换单个 Prefab 根对象的 activeSelf，支持 dry-run、Undo、保存与回读验证。",
      "effect": "editor-write",
      "environment": ["editor"],
      "requiredCapabilities": ["editor.status", "editor.tool.write"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetPath", "expectedSha256", "isActive"],
        "properties": {
          "assetPath": { "type": "string" },
          "expectedSha256": { "type": "string" },
          "isActive": { "type": "boolean" },
          "dryRun": { "type": "boolean" }
        }
      },
      "resultSchema": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["projectPath", "assetPath", "previousSha256", "newSha256", "wasActive", "isActive", "changed", "saved", "dryRun", "undoGroup", "verified"],
            "properties": {
              "projectPath": { "type": "string" },
              "assetPath": { "type": "string" },
              "previousSha256": { "type": "string" },
              "newSha256": { "type": "string" },
              "wasActive": { "type": "boolean" },
              "isActive": { "type": "boolean" },
              "changed": { "type": "boolean" },
              "saved": { "type": "boolean" },
              "dryRun": { "type": "boolean" },
              "undoGroup": { "type": "string" },
              "verified": { "type": "boolean" }
            }
          },
          "changedAssets": { "type": "array" },
          "warnings": { "type": "array" },
          "errors": { "type": "array" },
          "artifacts": { "type": "array" },
          "proof": { "type": "object" },
          "next": { "type": ["object", "null"] }
        }
      },
      "timeoutSeconds": 120,
      "artifacts": [],
      "implemented": true,
      "milestone": "M3",
      "availability": "available",
      "notes": "输入严格为 {assetPath, expectedSha256, isActive, dryRun?}；Submit 前由 Workspace 校验 SHA-256 CAS，不一致返回 PRECONDITION_FAILED 且不触达 Editor。上游 tool 为 bdtool_core_prefab_set_active；非 dry-run 使用 Undo 组、保存、强制同步导入与回读验证，要求 verified=true、isActive 回读正确且写入后 SHA 变化，并以磁盘指纹作为证据；提交后超时/取消或无法确认结果返回 EXECUTION_UNCERTAIN。dryRun 不创建 Undo、不保存、不要求 SHA 变化。仅支持单资产 Prefab 根对象 activeSelf，不支持 multi-asset、bulk 或 M4 能力；真实 Unity M3 端到端尚未验证。"
    },
    {
      "id": "workspace.read",
      "description": "读取项目内 UTF-8 文本文件，剥离 BOM 并对原始磁盘字节计算 SHA-256。",
      "effect": "read",
      "environment": ["workspace"],
      "requiredCapabilities": ["workspace.read"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relativePath"],
        "properties": {
          "relativePath": { "type": "string" }
        }
      },
      "resultSchema": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["relativePath", "content", "sha256", "length"],
            "properties": {
              "relativePath": { "type": "string" },
              "content": { "type": "string" },
              "sha256": { "type": "string" },
              "length": { "type": "integer" }
            }
          },
          "changedAssets": { "type": "array" },
          "warnings": { "type": "array" },
          "errors": { "type": "array" },
          "artifacts": { "type": "array" },
          "proof": { "type": "object" },
          "next": { "type": ["object", "null"] }
        }
      },
      "timeoutSeconds": 30,
      "artifacts": [],
      "implemented": true,
      "milestone": "M1",
      "availability": "available",
      "notes": "最大读取 1 MiB（恰好 1 MiB 允许，超过返回 INVALID_ARGUMENT）；目标缺失 NOT_FOUND，目录或非法路径 INVALID_ARGUMENT。输入不含 projectPath，项目边界由 --project/绑定根决定。"
    },
    {
      "id": "workspace.search",
      "description": "在项目内执行大小写敏感的字面量文本搜索，跳过排除目录与二进制文件。",
      "effect": "read",
      "environment": ["workspace"],
      "requiredCapabilities": ["workspace.search"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query"],
        "properties": {
          "query": { "type": "string" },
          "glob": { "type": "string" },
          "maxResults": { "type": "integer" }
        }
      },
      "resultSchema": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["matches", "truncated", "skippedBinary", "skippedTooLarge", "skippedSymlink"],
            "properties": {
              "matches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["relativePath", "lineNumber", "line"],
                  "properties": {
                    "relativePath": { "type": "string" },
                    "lineNumber": { "type": "integer" },
                    "line": { "type": "string" }
                  }
                }
              },
              "truncated": { "type": "boolean" },
              "skippedBinary": { "type": "integer" },
              "skippedTooLarge": { "type": "integer" },
              "skippedSymlink": { "type": "integer" }
            }
          },
          "changedAssets": { "type": "array" },
          "warnings": { "type": "array" },
          "errors": { "type": "array" },
          "artifacts": { "type": "array" },
          "proof": { "type": "object" },
          "next": { "type": ["object", "null"] }
        }
      },
      "timeoutSeconds": 60,
      "artifacts": [],
      "implemented": true,
      "milestone": "M1",
      "availability": "available",
      "notes": "空或全空白 query 返回 INVALID_ARGUMENT；排除 .git/.bdtool/bin/obj/Library/Temp/Logs/UserSettings/node_modules/.vs；maxResults 先收敛到 Provider 上限，匹配最多收集有效 maxResults+1 条并继续统计 skipped，超过上限时 truncated=true；打开候选前整链复检 reparse（计入 skippedSymlink）；排序先按路径序再按 Ordinal 兜底。输入不含 projectPath，项目边界由 --project/绑定根决定。"
    },
    {
      "id": "workspace.fingerprint",
      "description": "计算项目内一个或多个文件的存在性与原始字节 SHA-256。",
      "effect": "read",
      "environment": ["workspace"],
      "requiredCapabilities": ["workspace.fingerprint"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relativePaths"],
        "properties": {
          "relativePaths": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["files"],
            "properties": {
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["relativePath", "sha256", "length", "exists"],
                  "properties": {
                    "relativePath": { "type": "string" },
                    "sha256": { "type": "string" },
                    "length": { "type": "integer" },
                    "exists": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "changedAssets": { "type": "array" },
          "warnings": { "type": "array" },
          "errors": { "type": "array" },
          "artifacts": { "type": "array" },
          "proof": { "type": "object" },
          "next": { "type": ["object", "null"] }
        }
      },
      "timeoutSeconds": 60,
      "artifacts": [],
      "implemented": true,
      "milestone": "M1",
      "availability": "available",
      "notes": "relativePaths 必填，空数组合法；缺失文件返回 exists=false、sha256 为空字符串。输入不含 projectPath，项目边界由 --project/绑定根决定。"
    },
    {
      "id": "workspace.apply",
      "description": "以 UTF-8 无 BOM 原子写入项目内文本文件，支持 CAS 与 dry-run。",
      "effect": "workspace-write",
      "environment": ["workspace"],
      "requiredCapabilities": ["workspace.write"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relativePath", "content"],
        "properties": {
          "relativePath": { "type": "string" },
          "content": { "type": "string" },
          "expectedSha256": { "type": ["string", "null"] },
          "createIfMissing": { "type": "boolean" },
          "dryRun": { "type": "boolean" }
        }
      },
      "resultSchema": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["relativePath", "newSha256", "changed", "created", "dryRun"],
            "properties": {
              "relativePath": { "type": "string" },
