<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BDTool.Cli</RootNamespace>
    <AssemblyName>bdtool</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BDTool.Contracts\BDTool.Contracts.csproj" />
    <ProjectReference Include="..\BDTool.Application\BDTool.Application.csproj" />
    <ProjectReference Include="..\BDTool.Composition\BDTool.Composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\catalog\operations.json" Link="catalog\operations.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 发布包内的固定 Skill 随 CLI 输出，references 子目录保持原层级。 -->
    <Content Include="..\..\skills\**\*" Link="skills\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\agents\*.toml" Link="agents\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
