<UserControl
    x:Class="BDTool.Desktop.Controls.StatePanel"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,12" Padding="24" Style="{StaticResource SurfaceBorder}">
        <StackPanel HorizontalAlignment="Center">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SectionTitleText}"
                Text="{Binding Title, ElementName=Root}" />
            <TextBlock
                MaxWidth="520"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryText}"
                Text="{Binding Message, ElementName=Root}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
