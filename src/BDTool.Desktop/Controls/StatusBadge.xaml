<UserControl
    x:Class="BDTool.Desktop.Controls.StatusBadge"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="8,4"
        CornerRadius="{StaticResource radius.sm}"
        Background="{Binding Semantic, ElementName=Root, Converter={StaticResource StatusSemanticBrushConverter}}">
        <TextBlock
            FontSize="11"
            FontWeight="SemiBold"
            Foreground="White"
            Text="{Binding Text, ElementName=Root}" />
    </Border>
</UserControl>
