<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="background.canvas">#F3F5F8</Color>
    <Color x:Key="background.primary">#FFFFFF</Color>
    <Color x:Key="background.secondary">#E9EDF2</Color>
    <Color x:Key="background.hover">#DDE3EA</Color>
    <Color x:Key="border.default">#CDD4DD</Color>
    <Color x:Key="border.strong">#AEB8C5</Color>
    <Color x:Key="text.primary">#18202A</Color>
    <Color x:Key="text.secondary">#4C5968</Color>
    <Color x:Key="text.tertiary">#738091</Color>
    <Color x:Key="accent.default">#246FDB</Color>
    <Color x:Key="accent.hover">#185DBD</Color>
    <Color x:Key="accent.subtle">#DCEAFF</Color>
    <Color x:Key="success">#1F883D</Color>
    <Color x:Key="warning">#9A6700</Color>
    <Color x:Key="danger">#CF222E</Color>
    <Color x:Key="uncertain">#8250DF</Color>
    <Color x:Key="info">#0969DA</Color>
    <Color x:Key="overlay.scrim">#66000000</Color>

    <SolidColorBrush x:Key="brush.background.canvas" Color="{StaticResource background.canvas}" />
    <SolidColorBrush x:Key="brush.background.primary" Color="{StaticResource background.primary}" />
    <SolidColorBrush x:Key="brush.background.secondary" Color="{StaticResource background.secondary}" />
    <SolidColorBrush x:Key="brush.background.hover" Color="{StaticResource background.hover}" />
    <SolidColorBrush x:Key="brush.border.default" Color="{StaticResource border.default}" />
    <SolidColorBrush x:Key="brush.border.strong" Color="{StaticResource border.strong}" />
    <SolidColorBrush x:Key="brush.text.primary" Color="{StaticResource text.primary}" />
    <SolidColorBrush x:Key="brush.text.secondary" Color="{StaticResource text.secondary}" />
    <SolidColorBrush x:Key="brush.text.tertiary" Color="{StaticResource text.tertiary}" />
    <SolidColorBrush x:Key="brush.accent.default" Color="{StaticResource accent.default}" />
    <SolidColorBrush x:Key="brush.accent.hover" Color="{StaticResource accent.hover}" />
    <SolidColorBrush x:Key="brush.accent.subtle" Color="{StaticResource accent.subtle}" />
    <SolidColorBrush x:Key="brush.success" Color="{StaticResource success}" />
    <SolidColorBrush x:Key="brush.warning" Color="{StaticResource warning}" />
    <SolidColorBrush x:Key="brush.danger" Color="{StaticResource danger}" />
    <SolidColorBrush x:Key="brush.uncertain" Color="{StaticResource uncertain}" />
    <SolidColorBrush x:Key="brush.info" Color="{StaticResource info}" />
    <SolidColorBrush x:Key="brush.overlay.scrim" Color="{StaticResource overlay.scrim}" />

    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="spacing.xs">4</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="spacing.sm">8</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="spacing.md">12</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="spacing.lg">16</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="spacing.xl">24</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="spacing.2xl">32</sys:Double>
    <CornerRadius x:Key="radius.sm">4</CornerRadius>
    <CornerRadius x:Key="radius.md">6</CornerRadius>
    <CornerRadius x:Key="radius.lg">8</CornerRadius>
    <FontFamily x:Key="font.ui">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="font.code">Cascadia Code, Consolas</FontFamily>
</ResourceDictionary>
