<UserControl
    x:Class="BDTool.Desktop.Views.PlaceholderPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BDTool.Desktop.Controls"
    xmlns:vm="clr-namespace:BDTool.Presentation.ViewModels;assembly=BDTool.Presentation"
    Background="{StaticResource brush.background.canvas}">
    <Grid
        Margin="24,20"
        Background="{StaticResource brush.background.canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}" />
        <controls:StatePanel
            Grid.Row="1"
            Title="{Binding StateTitle}"
            Message="{Binding StateMessage}" />
    </Grid>
</UserControl>
